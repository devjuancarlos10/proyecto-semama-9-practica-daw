<?xml version="1.0" encoding="UTF-8"?>
<!--
  Universidad Nacional del Centro del Perú
  Facultad de Ingeniería de Sistemas
  Asignatura: Desarrollo de Aplicaciones Web (IS093A)
  Práctica Semana 09: Descriptor de Despliegue Jakarta EE 10 / Servlet 6.0
  
  /* IA: Compatibilidad de web.xml con Jakarta EE en Tomcat 10+
     → Solución manual: Tomcat 10+ migró del namespace javax.* a jakarta.*. 
       Por tanto, el descriptor de despliegue debe utilizar el schema XML de Jakarta Servlet 6.0 
       (version="6.0") con namespace https://jakarta.ee/xml/ns/jakartaee en lugar de sun.com o jcp.org, 
       garantizando validación limpia sin warnings en catalina.out. */
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>UNCP - Practica Semana 09 (JSP Tomcat 10)</display-name>
    <description>
        Laboratorio de Despliegue Backend en Servidor Tomcat 10.x para Desarrollo de Aplicaciones Web
    </description>

    <!-- Archivo de Bienvenida por Defecto -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Configuración de Tiempo de Expiración de Sesión -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

</web-app>
